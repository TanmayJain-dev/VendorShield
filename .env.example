# VendorShield Environment Configuration
# NEVER commit .env files containing real secrets

# Backend Port & Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# TinyFish API Key (Leave empty to use deterministic SIMULATED research fixtures)
TINYFISH_API_KEY=

# Storage Directory for Invoices
UPLOAD_DIR=./uploads
AUDIT_LOG_DIR=./audit_logs

# Rules Engine Version
RULES_VERSION=1.0.0
