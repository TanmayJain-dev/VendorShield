# VendorShield AI — Environment Configuration
# NEVER commit real production secrets to version control.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite default for local MVP, PostgreSQL supported in production)
DATABASE_URL=sqlite:///./vendorshield.db

# Storage Directories
UPLOAD_DIR=./uploads
AUDIT_LOG_DIR=./audit_logs

# Demo Data Isolation
# When DEMO_MODE=true, demo-flagged scenarios use synthetic demonstration fixtures.
# When SEED_DEMO_DATA=true, demo cases are seeded into the database at startup.
DEMO_MODE=false
SEED_DEMO_DATA=false

# Experimental Forensics (Hops 2-4: Director Shell Contagion, Collocation Ghost Hub, NCLT Sweep)
# Default is false: core deterministic scoring only relies on verified/attested evidence.
ENABLE_EXPERIMENTAL_FORENSICS=false

# Layered Extraction Pipeline (Phase B: QR + Text + LLM)
# Options: none | gemini | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Pluggable Registry Providers (Phase C)
# Comma-separated order: manual,http_kyc,tinyfish,demo
GSTIN_PROVIDERS=manual
GSTIN_API_URL_TEMPLATE=
GSTIN_API_AUTH_HEADER=
GSTIN_API_AUTH_VALUE=
GSTIN_API_FIELD_MAP={}

# Buyer Entity GSTINs (comma-separated list of own registered GSTINs for ITC claim verification)
BUYER_GSTINS=

# E-Invoice QR Verification (Optional: public key PEM for IRP digital signature verification)
IRP_PUBLIC_KEY_PEM=

# Minimal Token Authentication (Phase D)
# JSON list of user credentials: [{"token":"analyst-token","id":"priya","role":"ap_analyst"}]
USERS_JSON=
AUTH_DISABLED=false

# Reviewer Dev Mode (allowed only in development environment)
REVIEWER_DEV_MODE=true
DEV_REVIEWER_TOKEN=vendorshield-dev-review-token-2026

# TinyFish Live Research Agent API Key (Optional: leave empty to fail closed to UNAVAILABLE)
TINYFISH_API_KEY=
TINYFISH_API_URL=https://agent.tinyfish.ai/v1/automation/run

# Rules Engine Version
RULES_VERSION=2.0.0
