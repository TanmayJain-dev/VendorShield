# VendorShield Environment Configuration
# NEVER commit .env files containing real secrets

# Backend Port & Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection (SQLite default for local MVP, supports postgresql://... in production)
DATABASE_URL=sqlite:///./vendorshield.db

# TinyFish Web Research API Key (Leave empty to use transparent SIMULATED research fixtures)
# Live TinyFish SSE Streaming: set key and set TINYFISH_MODE=live
TINYFISH_API_KEY=sk-tinyfish-your-key-here
TINYFISH_MODE=live
TINYFISH_SSE_URL=https://agent.tinyfish.ai/v1/automation/run-sse

# Storage Directories
UPLOAD_DIR=./uploads
AUDIT_LOG_DIR=./audit_logs

# Reviewer Auth & Dev Mode
REVIEWER_DEV_MODE=true
DEV_REVIEWER_TOKEN=vendorshield-dev-review-token-2026

# Rules Engine Version
RULES_VERSION=2.1.0
